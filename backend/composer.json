{
  "name": "videorecipe/backend",
  "description": "PHP proxy that fronts the Anthropic Claude API for the videorecipe Flutter app.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "slim/slim": "^4.0",
    "slim/psr7": "^1.6",
    "guzzlehttp/guzzle": "^7.8",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
