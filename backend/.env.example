# Copy to .env on the server and fill in real values. Never commit .env.

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# CORS — comma-separated origins, or "*" for any (mobile apps don't honor CORS,
# so * is fine in practice; tighten if you also serve a web client).
ALLOWED_ORIGINS=*

# Per-IP, per-minute request cap.
RATE_LIMIT_PER_MINUTE=10

# Reject transcripts larger than this many bytes (cost cap).
MAX_TRANSCRIPT_BYTES=200000

# "production" hides stack traces in error responses.
APP_ENV=production
